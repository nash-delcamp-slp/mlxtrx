#!/bin/sh
# Test stand-in for the PKanalix grid submit command. Reads `-p <project>`,
# copies the contents of $MLXTRX_FAKE_DIR/pkx_results into the project's
# export folder and prints a job ID taken from $MLXTRX_FAKE_DIR/next_job.
fake="$MLXTRX_FAKE_DIR"
project=""
while [ $# -gt 0 ]; do
  case "$1" in
    -p) project="$2"; shift 2 ;;
    *) shift ;;
  esac
done
dir=$(dirname "$project")
export_path=$(sed -n "s/^[[:space:]]*exportpath[[:space:]]*=[[:space:]]*['\"]\(.*\)['\"].*/\1/p" "$project")
mkdir -p "$dir/$export_path"
cp -R "$fake/pkx_results/." "$dir/$export_path/"
n=1
if [ -e "$fake/next_job" ]; then
  n=$(cat "$fake/next_job")
fi
echo $((n + 1)) > "$fake/next_job"
echo "Submitted batch job $n"
